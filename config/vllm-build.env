# Pinned inputs for bin/build-vllm. Update this file, then run `make vllm`.
VLLM_REPO=https://github.com/vllm-project/vllm.git
VLLM_REF=647a76866b4559a74e27d1c6b55fbffe85c07ce4
VLLM_SOURCE_DIR=${HOME}/dev/vllm

# wheel:  install vLLM's prebuilt ROCm wheel as is. Its torch pulls in a complete
#         ROCm (rocm-sdk-* wheels) into the venv, so the servers never load the
#         system /opt/rocm and survive system ROCm updates.
# source: install the wheel for its dependencies, then replace vLLM with a source
#         build of VLLM_REF compiled against the system /opt/rocm.
VLLM_INSTALL=wheel

# The rocm100 index is the only ROCm 10 one and publishes cp314 wheels only.
VLLM_ROCM_VARIANT=rocm100
VLLM_BOOTSTRAP_WHEEL=https://wheels.vllm.ai/rocm/647a76866b4559a74e27d1c6b55fbffe85c07ce4/rocm100-wheels/vllm-0.34.0rc1.dev1133%2Bg647a76866.rocm100-cp314-cp314-manylinux_2_34_x86_64.whl
VLLM_WHEEL_INDEX=https://wheels.vllm.ai/rocm/nightly/rocm100

VLLM_PYTHON=3.14
VLLM_GPU_ARCH=gfx1201
VLLM_PREFIX=${HOME}/opt/vllm

# ROCm's PyTorch build still links OpenMPI 4's C++ ABI, which OpenMPI 5 removed.
# Keep the compatible runtime private instead of changing the host MPI stack.
# Used by VLLM_INSTALL=source only.
OPENMPI_VERSION=4.1.8
OPENMPI_SHA256=fb41086bbed9300baa2f3d7572491facfe5257412fa524ec5a396aa9101d5c62
OPENMPI_URL=https://download.open-mpi.org/release/open-mpi/v4.1/openmpi-4.1.8.tar.gz

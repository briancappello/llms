# Pinned inputs for bin/build-vllm. Update this file, then run `make vllm`.
VLLM_REPO=https://github.com/vllm-project/vllm.git
VLLM_REF=0961bbae2894d574be790d219651824eb199318e
VLLM_SOURCE_DIR=${HOME}/dev/vllm

# This wheel bootstraps the matching ROCm Python dependencies. vLLM itself is
# subsequently replaced by a source build from VLLM_REF.
VLLM_ROCM_VARIANT=rocm723
VLLM_BOOTSTRAP_WHEEL=https://wheels.vllm.ai/rocm/0961bbae2894d574be790d219651824eb199318e/vllm-0.3.1.dev251%2Bg0961bbae2.rocm723-cp312-cp312-manylinux_2_39_x86_64.whl
VLLM_WHEEL_INDEX=https://wheels.vllm.ai/rocm/nightly/rocm723

VLLM_PYTHON=3.12
VLLM_GPU_ARCH=gfx1201
VLLM_PREFIX=${HOME}/opt/vllm

# ROCm's PyTorch build still links OpenMPI 4's C++ ABI, which OpenMPI 5 removed.
# Keep the compatible runtime private instead of changing the host MPI stack.
OPENMPI_VERSION=4.1.8
OPENMPI_SHA256=fb41086bbed9300baa2f3d7572491facfe5257412fa524ec5a396aa9101d5c62
OPENMPI_URL=https://download.open-mpi.org/release/open-mpi/v4.1/openmpi-4.1.8.tar.gz
